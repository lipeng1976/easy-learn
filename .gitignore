# ─────────────────────────────────────────────────────────────
# 根 .gitignore —— 全仓通用
# 原则：密钥、运行期数据、构建产物一律不进版本库。
#       .env.example 是唯一允许提交的 env 文件。
# ─────────────────────────────────────────────────────────────

# 密钥与本机配置
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
local.properties
secrets/
credentials/
s.yaml
serverless*.yaml
# 本机演示栈的运行期凭据：首次随机生成、之后复用，绝不入库
/.dev-credentials.json

# 运行期数据（附件根目录、本地数据库、导出物）
var/
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
.pgdata*/
out/
logs/
*.log
tmp_*.log
nul

# 构建产物与二进制交付物
build/
dist/
*.apk
*.aab
*.ipa
*.dmg
*.exe
*.msix
*.zip
site/
site-old-*/

# 依赖
node_modules/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/

# Flutter 平台临时/构建目录（★ 体积大头，325MB 曾差点入库）
**/ephemeral/
**/.gradle/
**/.kotlin/
**/Pods/
**/DerivedData/
**/.symlinks/
*.iml
*.ipr
*.iws

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
.workbuddy-tmp/
