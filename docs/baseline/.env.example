# ─────────────────────────────────────────────────────────────────────────────
# 伴学 APP —— 环境变量示例（唯一允许提交的环境变量文件）
#
# 用法：cp .env.example .env ，然后把所有 CHANGE_ME 换成真实值。
# 规则：
#   1) 本文件里**没有任何一个真实密钥**，全部是占位符；
#   2) 代码里不出现任何密钥字面量，一律通过 backend/shared/config.js 读取；
#   3) 缺必需变量时服务启动即报错退出，不静默降级；
#   4) 前端变量只在**构建期**通过 --dart-define 注入，不注入 Node 进程、不编译进源码。
#
# 完整说明见 docs/environment.md
# ─────────────────────────────────────────────────────────────────────────────

# ===== 运行模式 =====
NODE_ENV=development
LOG_LEVEL=info

# ===== 服务端口 =====
DATA_SERVICE_PORT=8788
AI_GATEWAY_PORT=8787

# ===== PostgreSQL =====
# DATABASE_URL 是应用连接串，必须用非 superuser 的 app_rls 角色，否则 RLS 静默失效。
DATABASE_URL=postgresql://app_rls:CHANGE_ME@127.0.0.1:5432/easylearn
# 运维/迁移连接串（建表、建角色用）。生产环境应为独立账号，仅本地脚本使用。
PG_OPS_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/easylearn
PGSSLMODE=disable
PG_POOL_MAX=10
# 应用角色名与其口令：由 scripts/init-db.mjs 用来建/改角色，DDL 里不含任何口令。
PG_APP_ROLE=app_rls
APP_RLS_PASSWORD=CHANGE_ME

# ===== 会话与鉴权 =====
# 两个服务必须用同一把密钥；最少 32 字符；config.js 会校验长度。
AI_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
SESSION_TTL_HOURS=168
# 本地开发可关；生产必须为 true（否则 /data/* 与 /ai/* 可被匿名调用）。
AI_REQUIRE_AUTH=false

# ===== 附件存储（★ 数据库只存相对路径）=====
# STORAGE_ROOT 是**唯一**配置根目录的地方。所有附件在库里只存相对它的路径，
# 例如 20261121/stu_001/ab12cd34.jpg。代码通过 backend/shared/paths.js 解析。
# 允许写成绝对路径或相对项目根的路径，但**绝不写进数据库**。
STORAGE_ROOT=./var/storage
# local = 本地文件系统；oss = 对象存储。写错值直接抛错，绝不静默退回。
IMAGE_DRIVER=local
# IMAGE_DRIVER=oss 时必填；local 时留空即可。
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== AI 网关 =====
# 厂商开关：bailian / ark。切换后模型名、单价、思维链名单要一起换。
AI_MODEL_PROVIDER=bailian
BAILIAN_API_KEY=CHANGE_ME
BAILIAN_MODEL=qwen-plus
ARK_API_KEY=
ARK_MODEL=
AI_GATEWAY_TIMEOUT_MS=12000

# ===== ima 知识库（可选能力，没有就整段留空）=====
# 不配置时相关功能静默降级：不报错、不弹红条、不拖垮主流程。
IMA_CLIENT_ID=
IMA_API_KEY=
# 加密 ima 凭证用的密钥，最少 32 字符；不启用 ima 时可留空。
IMA_CREDENTIAL_SECRET=

# ===== 前端构建期变量（构造 --dart-define 参数用）=====
# 这些值不会注入 Node 进程。运行方式见 README「本地启动」。
DATA_API_BASE_URL=http://127.0.0.1:8788
AI_BASE_URL=http://127.0.0.1:8787
DATA_TIMEOUT_MS=12000
AI_TIMEOUT_MS=90000
AI_UPLOAD_TIMEOUT_MS=120000
AI_JUDGE_TIMEOUT_MS=45000
# 客户端连哪份库由构建期决定，换后端必须重新出包。
