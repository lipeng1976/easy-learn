# ─────────────────────────────────────────────────────────────────────────────
# 伴学 APP —— 环境变量示例（唯一允许提交的环境变量文件）
#
# 用法：cp .env.example .env ，然后把所有 CHANGE_ME 换成真实值。
# 规则：
#   1) 本文件里没有任何真实密钥，全部是占位符；.env 不进版本库；
#   2) 代码与 SQL 里没有任何**可用的**口令 / 密钥字面量：仓库里保留的三个
#      历史弱值只作黑名单，用来拒绝把它们粘进生产配置；
#   3) 生产值只从环境变量 / 云控制台注入；迁移建角色的口令由运行期
#      `set_config` 注入，SQL 本身不含口令；
#   4) 两个服务必须用同一把 AI_SESSION_SECRET（≥32 字符）；
#   5) 前端变量只在构建期通过 --dart-define 注入，不进 Node 进程、不编译进源码；
#   6) 下面 4 个凭据变量**留空是合法的**：本机演示栈会随机生成一次并持久化到
#      `.dev-credentials.json`（gitignore，重启复用）。生产环境留空会被
#      启动自检拦下，绝不静默放行；
#   7) 完整必需变量清单以 backend/data-service/scripts/check-config.mjs 为准。
#
# 说明：本仓已迁入全量业务源码，环境变量由各模块直接读取；
#       docs/baseline/ 里的「config.js 单点」是目标规范形态，尚未落地。
# ─────────────────────────────────────────────────────────────────────────────

# ===== 运行模式 =====
NODE_ENV=development
LOG_LEVEL=info

# ===== 服务端口 =====
DATA_SERVICE_PORT=8788
AI_GATEWAY_PORT=8787

# ===== PostgreSQL =====
# 应用连接串必须用 app_rls（非 superuser / 非表 owner），否则 RLS 静默失效。
DATABASE_URL=postgresql://app_rls:CHANGE_ME@127.0.0.1:5432/easylearn
PGSSLMODE=disable
PG_POOL_MAX=10
# 运维 / 迁移连接串，仅本地脚本使用。
PG_OPS_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/easylearn

# 本机演示栈的 3 个 PG 角色口令（见规则 6）。生产必填，且顺序是
# 「先 provision-app-roles.mjs 建角色，后 migrate.mjs 跑迁移」。
PG_ADMIN_PASSWORD=
APP_RLS_PASSWORD=
APP_AUTH_PASSWORD=

# ===== 会话与鉴权 =====
# 留空 ⇒ 本机演示栈生成随机密钥并复用；生产必填（≥32 字符），两个服务同值。
# 绝不能填历史公开值 dev-stack-secret-not-for-production（config-check 会拦）。
AI_SESSION_SECRET=
SESSION_TTL_HOURS=168
# 本地开发可关；生产必须为 true。
AI_REQUIRE_AUTH=false

# ===== 附件存储 =====
# 根目录只在配置里，数据库只存相对它的路径。
STORAGE_ROOT=./var/storage
# local / oss；写错值直接抛错，绝不静默退回。
IMAGE_DRIVER=local
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== AI 网关 =====
# 厂商开关：bailian / ark。切换后模型名、思维链名单、单价要一起换。
AI_MODEL_PROVIDER=bailian
BAILIAN_API_KEY=CHANGE_ME
BAILIAN_MODEL=qwen-plus
ARK_API_KEY=
ARK_MODEL=
AI_GATEWAY_TIMEOUT_MS=12000

# ===== ima 知识库（可选，没有就整段留空）=====
IMA_CLIENT_ID=
IMA_API_KEY=
IMA_CREDENTIAL_SECRET=

# ===== 前端构建期变量（构造 --dart-define 参数用）=====
DATA_API_BASE_URL=http://127.0.0.1:8788
AI_BASE_URL=http://127.0.0.1:8787
DATA_TIMEOUT_MS=12000
AI_TIMEOUT_MS=90000
AI_UPLOAD_TIMEOUT_MS=120000
AI_JUDGE_TIMEOUT_MS=45000
