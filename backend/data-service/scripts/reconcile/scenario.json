      }
    },
    {
      "step": "同一个幂等键再记一次（网络超时后的重试）—— 两侧都必须回原结果、且只有一行",
      "repo": "points",
      "method": "earnPoints",
      "as": "pt1",
      "args": {
        "studentId": "$student",
        "action": "planCheckin",
        "points": 5,
        "reason": "完成每日朗读",
        "idempotencyKey": "plan:$plan1:2026-09-18",
        "refType": "plan",
        "refId": "$plan1"
      }
    },
    {
      "step": "撤销打卡得分（按 studentId + 幂等键撤 —— 填两笔：标掉原记录 + 补一笔相反数）",
      "repo": "points",
      "method": "revokePoints",
      "as": "pt1",
      "args": {
