        "items": [
          {
            "mistakeId": "$mis1_0",
            "subject": "数学",
            "knowledgePoint": "分数",
            "questionTitle": "分数计算",
            "questionBody": "1/2 + 1/4 = ?",
            "originalAnswer": "3/4",
            "wrongReason": "分母处理错误",
            "answerKey": "3/4",
