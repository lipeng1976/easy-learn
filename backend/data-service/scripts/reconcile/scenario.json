      "method": "invite",
      "identity": "parent",
      "as": "rel1",
      "args": {
        "senderId": "$parent",
        "targetPhone": "13800000001"
      }
    },
    {
      "step": "学生接受邀请（pending → active）—— 这一步之后家长才「看得见」这个孩子",
      "repo": "relationship",
      "method": "updateStatus",
      "identity": "student",
      "args": {
        "id": "$rel1",
        "status": "active"
      }
    },
    {
      "step": "建作业",
      "repo": "homework",
      "method": "insertHomework",
      "as": "hw1",
      "args": {
        "title": "对账·数学作业",
        "subject": "数学",
        "imageUrl": "",
        "dueAt": "2026-09-18T12:00:00.000Z",
        "estimatedMinutes": 20,
        "status": "pending",
        "wrongCount": 0,
        "aiEnabled": 1,
        "needsGrading": 1,
        "studentId": "$student"
      }
    },
    {
      "step": "提交（字段掩码，与 HomeworkPatch.toMap() 逐字对应）",
      "repo": "homework",
      "method": "updateHomework",
      "args": {
        "id": "$hw1",
        "mask": {
          "status": "finished",
          "submittedAt": "2026-09-18T12:30:00.000Z",
          "submitBatchId": "batch_rec_1",
          "imageCount": 2,
          "imageUrl": "storage/rec-1.jpg",
