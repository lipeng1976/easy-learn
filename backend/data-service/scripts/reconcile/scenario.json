      "repo": "homework",
      "method": "saveHomeworkImages",
      "as": "img1",
      "args": {
        "studentId": "$student",
        "images": [
          {
            "homeworkId": "$hw1",
            "storageKey": "storage/rec-1.jpg",
            "fileName": "rec-1.jpg",
            "fileSize": 8,
            "mimeType": "image/jpeg",
            "ocrStatus": "none",
            "ocrText": "",
            "batchId": "batch_rec_1",
            "sortOrder": 0
          },
          {
            "homeworkId": "$hw1",
            "storageKey": "storage/rec-2.jpg",
            "fileName": "rec-2.jpg",
            "fileSize": 9,
            "mimeType": "image/jpeg",
            "ocrStatus": "none",
            "ocrText": "",
            "batchId": "batch_rec_1",
            "sortOrder": 1
          }
        ]
      }
    },
    {
      "step": "写错题",
      "repo": "review",
      "method": "insertReviewMistakes",
      "as": "mis1",
      "args": {
        "studentId": "$student",
        "items": [
          {
            "subject": "数学",
            "title": "分数计算",
            "originalAnswer": "3/4",
            "wrongReason": "分母处理错误",
            "createdAt": "2026-09-18T12:31:00.000Z",
            "state": "pending",
            "studentId": "$student",
            "homeworkId": "$hw1",
            "knowledgePoint": "分数",
            "wrongCount": 1,
            "sourceHomeworkTitle": "对账·数学作业"
          }
        ]
      }
    },
    {
      "step": "组卷（卷 + 题目一次原子写入）",
      "repo": "review",
      "method": "insertReviewPaperWithItems",
      "as": "paper1",
      "args": {
        "studentId": "$student",
        "paper": {
          "title": "对账·数学复习卷",
